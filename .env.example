# Base de datos SQLite (archivo local, se respalda junto con el almacen)
DATABASE_URL=./data/batuta.db

# Almacen de archivos protegidos: contratos, recibos, planeaciones, identificaciones.
# NUNCA debe quedar dentro de public/ ni servirse como ruta estatica.
ALMACEN_DIR=./almacen

# Llave para cifrar la tabla salud_alumno (datos personales sensibles, LFPDPPP).
# 32 bytes en hex. Generar con: openssl rand -hex 32
# Si se pierde, los datos de salud son irrecuperables. Guardarla fuera del servidor.
LLAVE_DATOS_SENSIBLES=

# Secreto de sesion. Generar con: openssl rand -base64 32
AUTH_SECRET=

# URL publica del sistema. El QR de la credencial la lleva dentro: si se genera
# con el host de una peticion interna, el codigo apunta a una direccion que el
# telefono del alumno no alcanza. En produccion es obligatoria.
URL_PUBLICA=

# Zona horaria de operacion. No cambiar sin revisar el modulo de agenda.
TZ=America/Mexico_City

# Asistente de IA: apagado por omision (decision del director).
IA_HABILITADA=false
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5
